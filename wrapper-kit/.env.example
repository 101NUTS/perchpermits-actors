# Copy to .env and fill in. Never commit .env.

# Stripe secret key. Use sk_test_... while testing, sk_live_... in production.
STRIPE_SECRET_KEY=sk_test_xxx

# Apify API token (Apify Console -> Settings -> Integrations).
APIFY_TOKEN=apify_api_xxx

# Actor to wrap, as owner~name.
APIFY_ACTOR=perchpermits~tennis-matches-odds-form

# One credit pack: price in cents and credits granted.
PACK_PRICE_CENTS=2000
PACK_CREDITS=200

# Credits charged per row returned, and the most rows one search may return.
CREDITS_PER_ROW=5
MAX_ROWS_PER_SEARCH=50

# Long random string used to sign customer tokens. Changing it invalidates every key.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=change-me

# Public URL of this server (Stripe redirects here after payment).
BASE_URL=http://localhost:3000
PORT=3000
